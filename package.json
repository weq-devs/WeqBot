{
  "name": "weqbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WeQ Bot — 独立 QQ bot 框架（mode2 自建上线），可作为纯 TS 嵌入 WeQ desktop",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev:cli": "tsx packages/node/src/cli.ts",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:pure-ts": "node scripts/check-pure-ts.mjs",
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
    "verify": "pnpm run check:pure-ts && pnpm run typecheck && pnpm run test",
    "sign:audit": "tsx scripts/sign-audit.mjs",
    "smoke:onebot": "node scripts/smoke-onebot.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
